# Backend environment variables (copy to .env for local non-Docker runs).
# In docker-compose these are provided by the compose file / root .env.

# Full SQLAlchemy/PostgreSQL connection string.
DATABASE_URL=postgresql://postgres:postgres@db:5432/inventory

# Comma-separated list of allowed CORS origins, or * for all.
# In production set this to your deployed frontend URL, e.g. https://your-app.vercel.app
CORS_ORIGINS=*

# Root environment file for docker-compose.
# Copy to ".env" and adjust. Never commit the real .env.
#
#   cp .env.example .env

# --- PostgreSQL ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-in-production
POSTGRES_DB=inventory

# --- Backend ---
# Comma-separated allowed CORS origins, or * for all (dev only).
CORS_ORIGINS=*

# --- Frontend (baked into the build) ---
# URL the browser uses to reach the backend.
VITE_API_URL=http://localhost:8000
